# AgentCore Runtime image running src/runtime.py (agent jobs and document indexing).
# AgentCore requires linux/arm64, port 8080, and the /invocations and /ping endpoints (served by
# BedrockAgentCoreApp). Build without attestations:
#   docker buildx build --platform linux/arm64 --provenance=false -f Dockerfile.agentcore -t <ecr repo>:<git sha> .

FROM ghcr.io/astral-sh/uv:0.9.26 AS uv

FROM --platform=linux/arm64 python:3.13-slim-bookworm

# DOCKER_CONTAINER: BedrockAgentCoreApp listens on 0.0.0.0 (reachable by AgentCore) only when it
# detects a container, and /.dockerenv may not exist in AgentCore.
ENV UV_COMPILE_BYTECODE=1 \
    UV_NO_INSTALLER_METADATA=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    DOCKER_CONTAINER=1 \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

# Exact versions from uv.lock into /app/.venv, without dev tools (pytest) or the project itself.
# This layer stays cached until uv.lock or pyproject.toml changes.
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-install-project

COPY src ./src

EXPOSE 8080

# src/runtime.py starts the server with app.run() on port 8080.
CMD ["python", "-m", "src.runtime"]
