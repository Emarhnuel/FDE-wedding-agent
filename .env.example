# Copy to .env and fill in. Never commit .env.

# Models + embeddings
OPENROUTER_API_KEY=

# InsForge (database + staff login). Use the admin API key, not the anon key.
INSFORGE_URL=
INSFORGE_API_KEY=
DATABASE_URL=

# CRM
HUBSPOT_PRIVATE_APP_TOKEN=

# Gmail (see docs/deployment-guide.md, Part 3.4)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=juniper-hollow-agent

# Switches
AUTO_SEND_ROUTINE=false
RUN_JOBS_LOCALLY=true
TEST_EMAIL_RECIPIENT=
