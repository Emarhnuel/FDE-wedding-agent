# The Lambda image only needs pyproject.toml, uv.lock, and src/. Everything else stays out of the build
# context, so no secrets or local files can end up in the image.

# Secrets and local settings
.env
.env.*
.mcp.json
.claude/
.devin/
.agents/

# Local environments, caches, and data
.venv/
.data/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Not part of the backend image
.git/
.github/
frontend/
terraform/
scripts/
tests/
evals/
docs/
images/
production-main/
claude_help/
*.md
*.pdf
Dockerfile*
.dockerignore
